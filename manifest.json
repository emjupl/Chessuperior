{
  "manifest_version": 3,
  "name": "Chessuperior",
  "version": "1.1",
  "icons": {
    "512": "logo.png"
  },
  "description": "Wtyczka dodająca przyciski umoźliwiające analizę partii poza Chess.com",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kliknij, aby otworzyć"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.chess.com/*"
      ],
      "css": [
        "style.css"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}