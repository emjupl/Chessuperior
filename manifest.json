{
  "manifest_version": 3,
  "name": "Chessuperior",
  "version": "1.2",
  "icons": {
    "512": "logo.png"
  },
  "description": "A plugin that adds buttons allowing for game analysis outside of Chess.com.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Click to open"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.chess.com/*"
      ],
      "css": [
        "style.css"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "chessuperior@emju.com",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}